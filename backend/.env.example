# Example environment variables for backend (copy to backend/.env and fill values)

# OpenAI (or other LLM provider) API key
OPENAI_API_KEY=

# Pinecone (optional) - for managed vector DB
PINECONE_API_KEY=
PINECONE_ENV=
PINECONE_INDEX=deeepr-index

# AWS S3 (optional) - if using S3 for storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
S3_BUCKET=

# Local/test settings
LOG_LEVEL=info
